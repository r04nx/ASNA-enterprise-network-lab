def start_metrics_server():
    """Start the metrics HTTP server"""
    server = HTTPServer(('0.0.0.0', METRICS_PORT), MetricsHandler)
    server_thread = threading.Thread(target=server.serve_forever)
    server_thread.daemon = True
    server_thread.start()
    logger.info(f"📊 Metrics server started on port {METRICS_PORT}")

# Global variables for current status
current_health_status = False
current_connectivity_status = False
current_interface_status = "DOWN"
current_route_status = False
current_ip_status = False
current_tc_drift = False

# Initialize global objects
metrics = MetricsCollector()
rl_agent = ReinforcementLearningAgent(LEARNING_RATE, EXPLORATION_RATE)

def main():
    """Main agent loop with enhanced AI decision making"""
    global current_health_status, current_connectivity_status, current_interface_status
    global current_route_status, current_ip_status, current_tc_drift
    
    logger.info("🤖 Starting AI-Enhanced Self-Healing Network Agent with Robust Connectivity Testing")
    logger.info(f"🎯 Target: {CHECK_HOST}:{CHECK_PORT} | Interface: {IFACE} | Gateway: {GATEWAY}")
    logger.info(f"🧠 AI Config: LR={LEARNING_RATE}, ER={EXPLORATION_RATE}")
    logger.info(f"🛠️  Network Tools Validated: {NETWORK_TOOLS_VALIDATED}")
    
    # Start metrics server
    start_metrics_server()
    
    failure_start_time = None
    
    while True:
        try:
            # Get current network state
            state = get_network_state()
            
            # Update global status variables for metrics
            current_interface_status = state.interface_status or "DOWN"
            current_connectivity_status = state.connectivity or False
            current_route_status = state.has_valid_default_route()
            current_ip_status = state.is_ip_in_expected_subnet()
            current_tc_drift = state.tc_rules and 'netem' in str(state.tc_rules)
            
            # Calculate overall health
            health_conditions = [
                state.interface_status == "UP",
                state.connectivity,
                state.has_valid_default_route(),
                state.is_ip_in_expected_subnet()
            ]
            
            current_health_status = all(health_conditions)
            
            if not current_health_status:
                if failure_start_time is None:
                    failure_start_time = time.time()
                    metrics.failure_count += 1
                    logger.warning("🚨 Network issues detected - AI remediation starting")
                
                # AI-powered remediation decision
                action, state_hash = ai_remediation_decision(state)
                
                # Execute the selected action
                metrics.remediation_attempts += 1
                actions_taken = execute_remediation_action(action)
                
                # Check if remediation was successful
                time.sleep(1)  # Brief wait for changes to take effect
                new_state = get_network_state()
                
                # Calculate reward based on improvement
                improvement = sum([
                    new_state.interface_status == "UP",
                    new_state.connectivity,
                    new_state.has_valid_default_route(),
                    new_state.is_ip_in_expected_subnet()
                ]) - sum(health_conditions)
                
                reward = improvement / 4.0  # Normalize to 0-1
                
                # Update AI learning
                new_state_hash = new_state.get_state_hash()
                rl_agent.update_q_value(state_hash, action, reward, new_state_hash)
                metrics.ai_learning_updates += 1
                
                if reward > 0:
                    metrics.ai_successful_decisions += 1
                    metrics.remediation_successes += 1
                
                if actions_taken:
                    logger.info(f"🔧 AI executed: {', '.join(actions_taken)} (reward: {reward:.2f})")
                
            else:
                if failure_start_time is not None:
                    recovery_time = time.time() - failure_start_time
                    metrics.mttr_times.append(recovery_time)
                    metrics.recovery_count += 1
                    failure_start_time = None
                    logger.info(f"✅ Network restored - MTTR: {recovery_time:.2f}s")
            
            time.sleep(SLEEP_INTERVAL)
            
        except KeyboardInterrupt:
            logger.info("🛑 Agent shutting down...")
            break
        except Exception as e:
            logger.error(f"❌ Unexpected error: {e}")
            time.sleep(SLEEP_INTERVAL)

if __name__ == "__main__":
    main()
